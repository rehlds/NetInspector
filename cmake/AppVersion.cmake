# The version the tool reports. A release build passes the tag's version as
# NETINSPECTOR_RELEASE_VERSION; any other build is <major>.<minor>.<commit count>-<hash>,
# marked dirty when the tree has changes.

set(NETINSPECTOR_VERSION_MAJOR 0)
set(NETINSPECTOR_VERSION_MINOR 1)

set(NETINSPECTOR_VERSION "${NETINSPECTOR_VERSION_MAJOR}.${NETINSPECTOR_VERSION_MINOR}.0")

find_package(Git QUIET)

if(NETINSPECTOR_RELEASE_VERSION)
	set(NETINSPECTOR_VERSION "${NETINSPECTOR_RELEASE_VERSION}")
elseif(GIT_FOUND AND EXISTS "${PROJECT_SOURCE_DIR}/.git")
	execute_process(
		COMMAND "${GIT_EXECUTABLE}" rev-list --count HEAD
		WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
		OUTPUT_VARIABLE NETINSPECTOR_COMMIT_COUNT
		OUTPUT_STRIP_TRAILING_WHITESPACE
		ERROR_QUIET
	)

	execute_process(
		COMMAND "${GIT_EXECUTABLE}" rev-parse --short=8 HEAD
		WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
		OUTPUT_VARIABLE NETINSPECTOR_COMMIT_HASH
		OUTPUT_STRIP_TRAILING_WHITESPACE
		ERROR_QUIET
	)

	execute_process(
		COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
		WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
		OUTPUT_VARIABLE NETINSPECTOR_CHANGES
		OUTPUT_STRIP_TRAILING_WHITESPACE
		ERROR_QUIET
	)

	if(NETINSPECTOR_COMMIT_COUNT)
		set(NETINSPECTOR_VERSION "${NETINSPECTOR_VERSION_MAJOR}.${NETINSPECTOR_VERSION_MINOR}.${NETINSPECTOR_COMMIT_COUNT}-${NETINSPECTOR_COMMIT_HASH}")
	endif()

	if(NETINSPECTOR_CHANGES)
		string(APPEND NETINSPECTOR_VERSION "-dirty")
	endif()
endif()

configure_file(
	"${PROJECT_SOURCE_DIR}/cmake/netinspector_version.h.in"
	"${PROJECT_BINARY_DIR}/generated/netinspector_version.h"
	@ONLY
)

message(STATUS "NetInspector ${NETINSPECTOR_VERSION}")
