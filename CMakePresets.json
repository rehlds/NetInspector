{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x86",
      "displayName": "Windows x86 (MSVC)",
      "inherits": "windows-base",
      "architecture": { "value": "Win32", "strategy": "set" }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (MSVC)",
      "inherits": "windows-base",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux (GCC)",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux (Clang)",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "linux-sanitizers",
      "displayName": "Linux (Clang, AddressSanitizer + UBSan)",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_ASAN": "ON",
        "ENABLE_UBSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-x86", "configurePreset": "windows-x86", "configuration": "Release" },
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "linux-gcc", "configurePreset": "linux-gcc" },
    { "name": "linux-clang", "configurePreset": "linux-clang" },
    { "name": "linux-sanitizers", "configurePreset": "linux-sanitizers" }
  ],
  "testPresets": [
    { "name": "windows-x86", "configurePreset": "windows-x86", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "linux-gcc", "configurePreset": "linux-gcc", "output": { "outputOnFailure": true } },
    { "name": "linux-clang", "configurePreset": "linux-clang", "output": { "outputOnFailure": true } },
    { "name": "linux-sanitizers", "configurePreset": "linux-sanitizers", "output": { "outputOnFailure": true } }
  ]
}
